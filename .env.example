DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true

# Eerste login wordt aangemaakt bij db:seed via deze waarden
SEED_USER_EMAIL="jij@example.com"
SEED_USER_PASSWORD="changeme"

# Externe scheduler roept GET /api/scan?cron_secret=... aan
CRON_SECRET=""

# eBay Browse API — laat leeg om de connector over te slaan
EBAY_APP_ID=""
EBAY_CERT_ID=""

# E-mailverzending via Resend; zonder key logt de app naar de console
RESEND_API_KEY=""
EMAIL_FROM="Modelspoor <noreply@example.com>"

# Web Push (VAPID). Genereren bv. via:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@example.com"

# Map waar mailgebaseerde connectors hun .eml-bestanden lezen
INBOX_ROOT="./inbox"
